{
  "expo": {
    "name": "DrinkTeam",
    "slug": "DrinkTeam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/VUTHazena.png",
    "scheme": "drinkteam",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/VUTHazena.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.itu.drinksteam"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0d8b0eaa-5a97-4d3d-851c-a4713f85a2db"
      }
    }
  }
}
